# TEMPLATE — merge with generated Laravel .env.example; not real credentials.
APP_NAME="Thu Thanh"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thu_thanh
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000

CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
FILESYSTEM_DISK=public
LOG_CHANNEL=daily
LOG_LEVEL=debug

STORE_DELIVERY_HOLD_SECONDS=300
STORE_PICKUP_HOLD_SECONDS=86400
STORE_QUOTE_TTL_SECONDS=300
STORE_MAX_QUANTITY=99
STORE_MAX_ORDER_VND=1000000000
# Blank uses the owner default of 25000 VND; pickup remains 0.
STORE_DELIVERY_FEE_VND=25000
STORE_REVENUE_POLICY=approved_v1
# Owner policy: no returns/refunds; refund writes are disabled in config.

PAYMENT_PROVIDER=vnpay
VNPAY_ENV=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return
VNPAY_IPN_URL=
# Set only after merchant capability verified
VNPAY_QR_CAPABILITY_VERIFIED=false

# Admin password belongs only in private local env or interactive command.
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Use separate phpunit/.env.testing configuration. Never point tests at thu_thanh.
TEST_DB_DATABASE=thu_thanh_test

HASH_DRIVER=argon2id
# D55: set false only after your own Sandbox TMN code/hash secret are filled in a private .env.
VNPAY_DEFERRED=true

# Only actual reverse proxy IPs/CIDRs; never trust all clients.
TRUSTED_PROXIES=

# Password recovery: configure real mail transport before enabling production delivery.
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="Nhà sách Thu Thanh"
# FRONTEND_URL must be the actual frontend HTTPS origin in production.
